{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-task-dataset.schema.json",
  "title": "Independent Android Harness Evaluation Dataset",
  "type": "object",
  "required": ["schema_version", "dataset_id", "authored_date", "evaluation_date", "methodology", "global_required_policies", "tasks"],
  "properties": {
    "schema_version": {"const": 1}, "dataset_id": {"type": "string"},
    "authored_date": {"type": "string", "format": "date"}, "evaluation_date": {"type": "string", "format": "date"},
    "methodology": {"type": "string", "minLength": 40},
    "global_required_policies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "tasks": {"type": "array", "minItems": 30, "items": {"type": "object",
      "required": ["id", "domain_group", "task", "expected_domains", "required_sources", "allowed_optional_sources", "forbidden_sources", "required_knowledge", "allowed_optional_knowledge", "required_skills", "allowed_optional_skills", "required_policies", "required_freshness_sources", "expected_routing_status", "required_evidence_actions"],
      "properties": {
        "id": {"type": "string"}, "domain_group": {"type": "string"}, "task": {"type": "string", "minLength": 8},
        "expected_domains": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "required_sources": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "allowed_optional_sources": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "forbidden_sources": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "required_knowledge": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "allowed_optional_knowledge": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "required_skills": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "allowed_optional_skills": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "required_policies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "required_freshness_sources": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "required_evidence_actions": {"type": "array", "items": {"type": "string"}},
        "expected_routing_status": {"enum": ["routed", "routed_with_limitations", "ambiguous_clarification_recommended", "uncertain_no_domain_match"]},
        "expected_classification_status": {"enum": ["matched", "multi_domain", "ambiguous", "unknown"]},
        "expected_source_access": {"type": "object", "additionalProperties": {"type": "string"}}, "negative_terms": {"type": "array", "items": {"type": "string"}}
      }, "additionalProperties": false
    }}
  }, "additionalProperties": false
}
